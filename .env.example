SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=agussuga403@gmail.com
MAIL_PASSWORD=rhbqsbvvvejgfiep
MAIL_FROM_ADDRESS=agussuga403@gmail.com
MAIL_FROM_NAME="TransSurvey"
# Safety switch: enable only after SMTP and recipient validation.
SURVEY_EMAIL_ENABLED=True
SURVEY_REMINDER_DAYS=3
SURVEY_MAX_REMINDERS=3
# Penerima email "Survei selesai" (pisahkan dengan koma). Kosongkan untuk mengirim ke semua admin.
SURVEY_COMPLETION_RECIPIENTS=gunawan@trans-cosmos.co.id,dean.maudy@trans-cosmos.co.id
LOG_CHANNEL=stack
LOG_LEVEL=info

# CXP SSO (Fase 2). Isi secret hanya di .env server, jangan commit nilainya.
CXP_SSO_SECRET=
CXP_SSO_PUBLIC_KEY=
CXP_SSO_PUBLIC_KEY_PATH=
CXP_SSO_ALGORITHMS=HS256
CXP_SSO_ISSUER=transcxp
CXP_SSO_AUDIENCE=transsurvey
CXP_SSO_TTL=300
CXP_SSO_LEEWAY=60
CXP_SSO_REDIRECT_ROUTE=dashboard
CXP_ALLOW_OPERATION_PASSWORD=false
CXP_LAUNCH_API_KEY=
CXP_LAUNCH_CODE_TTL=120

# TransCXP Ticket API (read-only). Isi kredensial hanya di .env server.
CXP_API_BASE_URL=https://crm.trans-cosmos.id
CXP_API_EMAIL=
CXP_API_PASSWORD=
CXP_API_TIMEOUT=30
CXP_API_LOGIN_FIELD=email
CXP_API_AUTH_HEADER=Authorization
CXP_API_AUTH_PREFIX=Bearer
CXP_API_TICKET_PATH=/api/v2/tickets
CXP_API_DETAIL_PATH=/api/v2/tickets
# Endpoint filter status + project (satu-satunya yang menyaring di server).
CXP_API_STATUS_PATH=/api/v1/dataTicketByStatus

# CSAT otomatis dari tiket Close (Fase 5).
# enabled=false berarti jadwal otomatis tidak berjalan; command manual tetap bisa.
CXP_CSAT_AUTOSEND=false
# Kosong = proses semua workspace bertemplate. Isi kode untuk membatasi satu project.
CXP_CSAT_WORKSPACE=
# Server membatasi per_page di 100.
CXP_CSAT_PER_PAGE=100
# 0 = baca semua halaman per project.
CXP_CSAT_MAX_PAGES=0
