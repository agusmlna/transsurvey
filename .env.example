APP_NAME=TransSurvey
APP_ENV=local
APP_KEY=base64:UK1Q+bp+HXKFOHO8wy87rzVxSSCbNgLFtfSWJpfqqYo=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE="D:/TCID/2026/Suara_Web_Survey_Laravel/suara-laravel/database/database.sqlite"
DB_USERNAME=suara_user
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=agussuga403@gmail.com
MAIL_PASSWORD=rhbqsbvvvejgfiep
MAIL_FROM_ADDRESS=agussuga403@gmail.com
MAIL_FROM_NAME="TransSurvey"
# SMTP kedua khusus CSAT. Jangan pakai akun SMTP operasi di atas.
# Isi kredensial hanya di .env server; kosongkan di repo.
MAIL_CSAT_SCHEME=smtp
MAIL_CSAT_HOST=
MAIL_CSAT_PORT=587
MAIL_CSAT_USERNAME=
MAIL_CSAT_PASSWORD=
MAIL_CSAT_FROM_ADDRESS=
MAIL_CSAT_FROM_NAME="CSAT TransSurvey"
# Safety switch: enable only after SMTP and recipient validation.
SURVEY_EMAIL_ENABLED=True
SURVEY_REMINDER_DAYS=3
SURVEY_MAX_REMINDERS=3
# Penerima email "Survei selesai" (pisahkan dengan koma). Kosongkan untuk mengirim ke semua admin.
SURVEY_COMPLETION_RECIPIENTS=gunawan@trans-cosmos.co.id,dean.maudy@trans-cosmos.co.id
LOG_CHANNEL=stack
LOG_LEVEL=info

# CXP SSO (Fase 2). Isi secret hanya di .env server, jangan commit nilainya.
CXP_SSO_SECRET=
CXP_SSO_PUBLIC_KEY=
CXP_SSO_PUBLIC_KEY_PATH=
CXP_SSO_ALGORITHMS=HS256
CXP_SSO_ISSUER=transcxp
CXP_SSO_AUDIENCE=transsurvey
CXP_SSO_TTL=300
CXP_SSO_LEEWAY=60
CXP_SSO_REDIRECT_ROUTE=dashboard
CXP_ALLOW_OPERATION_PASSWORD=false
CXP_LAUNCH_API_KEY=
CXP_LAUNCH_CODE_TTL=120

# TransCXP Ticket API (read-only). Isi kredensial hanya di .env server.
CXP_API_BASE_URL=https://crm.trans-cosmos.id
CXP_API_EMAIL=
CXP_API_PASSWORD=
CXP_API_TIMEOUT=30
CXP_API_LOGIN_FIELD=email
CXP_API_AUTH_HEADER=Authorization
CXP_API_AUTH_PREFIX=Bearer
CXP_API_TICKET_PATH=/api/v2/tickets
CXP_API_DETAIL_PATH=/api/v2/tickets
# Endpoint filter status + project (satu-satunya yang menyaring di server).
CXP_API_STATUS_PATH=/api/v1/dataTicketByStatus

# CSAT otomatis dari tiket Close (Fase 5).
# enabled=false berarti jadwal otomatis tidak berjalan; command manual tetap bisa.
CXP_CSAT_AUTOSEND=false
# Kosong = proses semua workspace bertemplate. Isi kode untuk membatasi satu project.
CXP_CSAT_WORKSPACE=
# Server membatasi per_page di 100.
CXP_CSAT_PER_PAGE=100
# 0 = baca semua halaman per project.
CXP_CSAT_MAX_PAGES=0

# Routing kanal CSAT otomatis (Fase 6b). Pisahkan dengan koma.
# WhatsApp -> WA dengan fallback email; Email -> SMTP TransSurvey;
# fallback -> email saja; skip -> tidak dikirim.
CXP_CSAT_WA_SOURCES=WhatsApp
CXP_CSAT_EMAIL_SOURCES=Email
CXP_CSAT_EMAIL_FALLBACK_SOURCES="Instagram,Facebook,Google_business,Twitter,Livechat,TikTok"
CXP_CSAT_SKIP_SOURCES="Call,Outbound Call,WAG,Whatsapp Call,Whatsapp Call Outbound"
CXP_CSAT_DEFAULT_CHANNEL=email

# TransCXP WhatsApp Broadcast API v2. Nomor pengirim berbeda per project.
CXP_WA_BASE_URL=https://transcxp.trans-cosmos.id
CXP_WA_TIMEOUT=30
CXP_WA_TEMPLATE_ID=
CXP_WA_TEMPLATE_NAME=
CXP_WA_TEMPLATE_LANGUAGE=id
# Urutan parameter body template, contoh: customer_name,survey_url,project_name
CXP_WA_TEMPLATE_PARAMS=customer_name,survey_url
# Opsional bila template memakai tombol URL dinamis, contoh: survey_url
CXP_WA_BUTTON_URL_PARAM=
# JSON kredensial per kode workspace. Isi hanya di .env server.
# {"22":{"username":"...","password":"...","number":"+62811..."}}
CXP_WA_ACCOUNTS=
CXP_WA_ACCOUNTS_FILE=
CXP_WA_TOKEN_CACHE_TTL=43200

# Onboarding workspace: cxp:csat-onboard
CXP_CSAT_MASTER_TEMPLATE_ID=
CXP_CSAT_PILOT_PROJECTS=
# Opsional: override daftar project, JSON {"4":"ABC","5":"..."}
CXP_CSAT_PROJECTS=
