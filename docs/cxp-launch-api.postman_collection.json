{
  "info": {
    "_postman_id": "9f5c1b6e-6a2f-4d2a-9b7a-cxp-launch-session",
    "name": "TransCXP → TransSurvey Launch Session",
    "description": "Kontrak POST /api/cxp/launch-sessions. Isi variable api_key lewat environment Postman, jangan disimpan di koleksi ini.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://10.0.24.118"
    },
    {
      "key": "api_key",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create launch session (login only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user\": {\n    \"id\": \"5\",\n    \"name\": \"Agent A\",\n    \"email\": \"agent@email.com\"\n  },\n  \"project\": {\n    \"id\": 23,\n    \"code\": \"23\",\n    \"name\": \"Panasonic\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/cxp/launch-sessions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cxp",
            "launch-sessions"
          ]
        },
        "description": "Tes paling sederhana. Balasan 201 berisi code, url, expires_in."
      }
    },
    {
      "name": "2. Create launch session (with ticket)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user\": {\n    \"id\": \"5\",\n    \"name\": \"Agent A\",\n    \"email\": \"agent@email.com\"\n  },\n  \"project\": {\n    \"id\": 23,\n    \"code\": \"23\",\n    \"name\": \"Panasonic\"\n  },\n  \"ticket\": {\n    \"id\": \"101\",\n    \"status\": \"open\",\n    \"channel\": \"whatsapp\",\n    \"customer\": {\n      \"id\": \"10\",\n      \"name\": \"Customer A\",\n      \"email\": \"customerA@email.com\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/cxp/launch-sessions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cxp",
            "launch-sessions"
          ]
        },
        "description": "Dengan satu tiket. customer berada di dalam ticket dan harus dikirim bersama."
      }
    }
  ]
}
